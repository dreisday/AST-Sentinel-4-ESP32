# Copy this file to secrets.yaml (in this same esphome/ directory) and fill
# in your own values. secrets.yaml is gitignored and must never be committed.

wifi_ssid: "WiFi_SSID"
wifi_password: "WiFi_Password"

# Password for the fallback AP hotspot the device creates if it can't join wifi_ssid.
ap_password: "ChangeMeFallbackPassword"

# 32-byte base64 key used to encrypt the Home Assistant native API connection.
# Generate one with:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# or use the "Generate" button in the ESPHome dashboard when adding the device.
api_encryption_key: "REPLACE_WITH_GENERATED_BASE64_KEY"

# Password required to push OTA firmware updates.
ota_password: "ChangeMeOtaPassword"
